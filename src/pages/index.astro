---
// One chat-like screen. Pyodide runs in public/worker.js; this page only draws what the worker reports.
import { sources } from "../models.js";
// the licenses of the models, one line per source, written at build time from src/models.js (T87)
const LOCAL_LICENSE = { "sbintuitions/tiny-lm": "models/tiny-lm.LICENSE.txt" };
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>Pyodide LLM</title>
    <!-- An icon without a file: a browser that finds none asks for /favicon.ico, and Edge reports the 404 as an error -->
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22%3E%3Ctext y=%22.9em%22 font-size=%2290%22%3E🦙%3C/text%3E%3C/svg%3E" />
  </head>
  <body>
    <!-- Two links to the repository, a ribbon and a corner: the script below shows one of them at random. -->
    <div class="ribbon" hidden><a href="https://github.com/takano32/pyodide-llm"><span class="long">Fork me on </span>GitHub</a></div>
    <!-- GitHub Corners, https://github.com/tholman/github-corners (MIT License) -->
    <a href="https://github.com/takano32/pyodide-llm" class="github-corner" aria-label="View source on GitHub" hidden>
      <svg viewBox="0 0 250 250" aria-hidden="true">
        <path d="M0,0 L115,115 L130,115 L142,142 L250,250 L250,0 Z"></path>
        <path d="M128.3,109.0 C113.8,99.7 119.0,89.6 119.0,89.6 C122.0,82.7 120.5,78.6 120.5,78.6 C119.2,72.0 123.4,76.3 123.4,76.3 C127.3,80.9 125.5,87.3 125.5,87.3 C122.9,97.6 130.6,101.9 134.4,103.2" fill="currentColor" style="transform-origin: 130px 106px;" class="octo-arm"></path>
        <path d="M115.0,115.0 C114.9,115.1 118.7,116.5 119.8,115.4 L133.7,101.6 C136.9,99.2 139.9,98.4 142.2,98.6 C133.8,88.0 127.5,74.4 143.8,58.0 C148.5,53.4 154.0,51.2 159.7,51.0 C160.3,49.4 163.2,43.6 171.4,40.1 C171.4,40.1 176.1,42.5 178.8,56.2 C183.1,58.6 187.2,61.8 190.9,65.4 C194.5,69.0 197.7,73.2 200.1,77.6 C213.8,80.2 216.3,84.9 216.3,84.9 C212.7,93.1 206.9,96.0 205.4,96.6 C205.1,102.4 203.0,107.8 198.3,112.5 C181.9,128.9 168.3,122.5 157.7,114.1 C157.9,116.9 156.7,120.9 152.7,124.9 L141.0,136.5 C139.8,137.7 141.6,141.9 141.8,141.8 Z" fill="currentColor" class="octo-body"></path>
      </svg>
    </a>
    <header>
      <div class="brand">
        <h1>Pyodide LLM</h1>
        <span class="badge">experiment</span>
      </div>
      <div class="models">
        <select id="model" aria-label="Model"></select>
        <!-- a model of the visitor's own disk: read where it is, nothing is uploaded -->
        <label class="open" title="Open a model from this device: a llama2.c checkpoint and its tokenizer.bin, or the files of a Hugging Face model (.safetensors, config.json, and tokenizer.json, tokenizer.model or spiece.model), and optionally settings as .json. Nothing is uploaded.">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M3 6a2 2 0 0 1 2-2h4.2a2 2 0 0 1 1.4.6L12 6h7a2 2 0 0 1 2 2v1H3zm0 5h18v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" fill="currentColor" /></svg>
          <input id="files" type="file" multiple hidden aria-label="Open a model from this device" />
        </label>
      </div>
    </header>

    <main id="chat">
      <section class="intro">
        <!-- one of the two, by the language of the browser (the script decides; without it both show) -->
        <p class="ja">
          ブラウザ上の WebAssembly 版 Python（Pyodide）で言語モデルを動かす実験です。読み込み・トークナイザ・サンプリング・生成のループは素の
          Python で、1 トークンぶんの計算は WASM SIMD カーネルが、使える端末では複数のコアで行います。実験なのでモデルは小さく、出力はそれなりです。
          既定のモデルはいちばん軽いモデルです。もっと自然な日本語は <button type="button" class="choose" data-model="llm-jp-3-150m">llm-jp-3 150M（171 MB）</button>
          で生成できます。一覧の最後のグループは Hugging Face から取得してこのブラウザの中で変換します。
          この端末の CPU・GPU・保存・回線は <a href="benchmark/">ベンチマーク</a> でまとめて測れます。
          くわしくは <a href="https://gist.github.com/takano32/196c6f93979ad44f98cee5712fdd3901">Pyodide LLM の概要</a> へ。
        </p>
        <p class="en">
          An experiment in running language models on Python on WebAssembly (Pyodide) in the browser: loading, the
          tokenizer, the sampling and the generation loop are plain Python, and the computation of each token runs in
          WASM SIMD kernels, on several cores where the device allows. The default is the lightest model;
          <button type="button" class="choose" data-model="llm-jp-3-150m">llm-jp-3 150M (171 MB)</button> generates far
          more natural Japanese. The last group of the list is fetched from Hugging Face and converted right here.
          The <a href="benchmark/">benchmark</a> measures this device's CPU, GPU, storage and line in one run.
        </p>
        <details>
          <summary>このプロジェクトについて / About, models and licenses</summary>
          <ul>
            <li><a href="https://github.com/takano32/pyodide-llm">github.com/takano32/pyodide-llm</a></li>
            <li><a href="https://gist.github.com/takano32/196c6f93979ad44f98cee5712fdd3901">Pyodide LLM の概要</a>: しくみと計測結果のまとめ / how it works and what was measured (in Japanese)</li>
            <li><a href="https://pyodide.org/">Pyodide</a>: Python for the browser, based on WebAssembly</li>
            <li><a href="https://github.com/tairov/llama2.py">llama2.py</a> and <a href="https://github.com/karpathy/llama2.c">llama2.c</a>, which the NumPy engine is a port of</li>
            <li><a href="?bench=1">Measure this browser</a>: the model of this page with and without the kernels, as a table you can copy or report (<a href="?bench=full">every step</a> takes longer)</li>
            <li><a href="benchmark/">Benchmark this device</a>: that and more in one run (the CPU, the GPU, the storage and the line), one report</li>
          </ul>
          <p>The models and their licenses. The models of the last group are fetched from Hugging Face when you choose one, and converted to int8 in this browser.</p>
          <ul class="sources">
            {sources().map(({ repo, license, names }) => (
              <li>
                <a href={`https://huggingface.co/${repo}`}>{repo}</a>{" "}
                (<a href={LOCAL_LICENSE[repo] ?? `https://huggingface.co/${repo}`}>{license}</a>): {names.join(", ")}
              </li>
            ))}
          </ul>
          <!-- what the conversions left in this browser, with a way to get the space back -->
          <div id="kept" hidden>
            <p>Converted models kept in this browser:</p>
            <ul id="kept-list"></ul>
          </div>
        </details>
      </section>
    </main>

    <footer>
      <div id="status" role="status">
        <!-- the same line as before; once the model is ready it opens into how long each part of the load took -->
        <details id="load">
          <summary id="status-text">Initializing...</summary>
          <div id="load-stats"></div>
        </details>
        <progress id="progress" hidden></progress>
      </div>
      <!-- The generation settings: a popover above its button, a sheet from the bottom on a narrow screen. It is
           no part of the form, or Enter in one of its fields would send the prompt. -->
      <div id="settings" class="sheet" popover>
        <label>Temperature <output id="temperature-value"></output>
          <input id="temperature" type="range" min="0" max="1.5" step="0.05" /></label>
        <label>Max tokens <output id="steps-value"></output>
          <input id="steps" type="range" min="16" max="256" step="8" /></label>
        <label>Seed
          <span class="seed-field">
            <input id="seed" type="text" inputmode="numeric" autocomplete="off" placeholder="random" />
            <button id="seed-clear" type="button" aria-label="Random seed" title="Random seed">×</button>
          </span></label>
        <details>
          <summary>More</summary>
          <label>Top-p <output id="topp-value"></output>
            <input id="topp" type="range" min="0.05" max="1" step="0.05" /></label>
          <label>Repetition penalty <output id="penalty-value"></output>
            <input id="penalty" type="range" min="1" max="2" step="0.05" /></label>
        </details>
        <!-- T75: what the computation runs on, one switch each (T52's ?without=). The URL is the state: a change
             rewrites it and reloads the page, so a link says what ran. -->
        <details id="engine">
          <summary>Engine</summary>
          <p class="hint">Each switch takes one optimization away, to see what it is worth. Changing one reloads the page and the model; the status line then says what ran.</p>
          <label class="switch"><input type="checkbox" data-switch="kernels" /> WASM SIMD kernels (NumPy without)</label>
          <label class="switch"><input type="checkbox" data-switch="int8" /> int8 weights kept as int8</label>
          <label class="switch"><input type="checkbox" data-switch="relaxed" /> relaxed SIMD, 7-bit activations</label>
          <label class="switch"><input type="checkbox" data-switch="sampler" /> sampling in the kernel</label>
          <!-- T98: the weights of a model converted in this browser (?bits=), the URL again the state -->
          <p class="hint">Weights of a model converted from Hugging Face: six bits take 7/9 of int8's memory and write about half as fast. Automatic keeps int8 unless it does not fit.</p>
          <label class="switch"><input type="radio" name="bits" value="" /> automatic</label>
          <label class="switch"><input type="radio" name="bits" value="8" /> int8</label>
          <label class="switch"><input type="radio" name="bits" value="6" /> 6 bits</label>
        </details>
        <button id="settings-reset" type="button">Reset to defaults</button>
      </div>
      <!-- T88: a repository that is in no list, from the last entry of the model list. It goes the way ?hf= goes,
           and the URL then says so, to share. -->
      <div id="repository" class="sheet" popover>
        <form id="repository-form">
          <label>Hugging Face repository
            <input id="repository-name" type="text" autocomplete="off" spellcheck="false" placeholder="owner/name" /></label>
          <label>Revision
            <input id="repository-revision" type="text" autocomplete="off" spellcheck="false" placeholder="main" /></label>
          <p class="hint">A Llama, Mistral, Qwen2, Qwen3, GPT-2 or GPT-NeoX model published as safetensors with a tokenizer.json or a sentencepiece model. It is fetched from huggingface.co and converted to int8 in this browser; what the converter cannot take, it refuses in words.</p>
          <button type="submit">Open</button>
        </form>
      </div>
      <form id="composer">
        <button id="settings-open" type="button" popovertarget="settings" aria-label="Generation settings" title="Generation settings">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M4 7h9m4 0h3M4 17h3m4 0h9M15 4.5v5M9 14.5v5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
        </button>
        <!-- Enter breaks the line, as it must while Japanese text is being converted; Ctrl or Cmd + Enter sends.
             One row looks like a field of one line, so the keys that send are written next to the button: whoever
             reads them knows what Enter alone does. A touch screen has no such keys, and no hint. -->
        <textarea id="prompt" rows="1" autocomplete="off" enterkeyhint="enter"></textarea>
        <kbd id="send-hint" aria-hidden="true">Ctrl ⏎</kbd>
        <!-- the same button stops the run that is going on; the script swaps the arrow for a square -->
        <button id="run" disabled aria-label="Run" title="Ctrl + Enter">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M3 20.5 21 12 3 3.5v6.6L15 12 3 13.9z" fill="currentColor" /></svg>
        </button>
      </form>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #ffffff; --panel: #f4f4f5; --text: #18181b; --muted: #71717a; --line: #e4e4e7;
    --accent: #2563eb; --accent-text: #ffffff; --bubble: #f4f4f5;
    font-family: system-ui, -apple-system, "Segoe UI", "Hiragino Sans", "Noto Sans JP", sans-serif;
  }
  @media (prefers-color-scheme: dark) {
    :root { --bg: #0f0f11; --panel: #1c1c1f; --text: #ededf0; --muted: #9a9aa3; --line: #2c2c31; --accent: #3b82f6; --bubble: #1c1c1f; }
  }
  * { box-sizing: border-box; }
  /* The page itself never scrolls: only the conversation does, and the composer stays at the bottom. */
  html, body { height: 100%; margin: 0; }
  body { display: flex; flex-direction: column; height: 100dvh; background: var(--bg); color: var(--text); line-height: 1.6; }
  #chat > * { width: 100%; max-width: 760px; margin-inline: auto; }
  /* their padding is inside the box: 760px of content, like the conversation */
  header, footer { width: 100%; max-width: 792px; margin-inline: auto; }

  /* the corner ribbon to the repository */
  .ribbon[hidden], .github-corner[hidden] { display: none; }
  .ribbon { position: fixed; top: 0; right: 0; width: 130px; height: 130px; overflow: hidden; pointer-events: none; z-index: 10; }
  .ribbon a { position: absolute; top: 28px; right: -46px; width: 190px; transform: rotate(45deg); pointer-events: auto;
    background: var(--text); color: var(--bg); text-align: center; text-decoration: none; font-size: 0.72rem; font-weight: 600;
    line-height: 2; box-shadow: 0 1px 4px rgb(0 0 0 / 0.3); }
  @media (max-width: 900px) {
    /* keep clear of the header on narrow screens */
    .ribbon { width: 60px; height: 60px; }
    .ribbon a { top: 8px; right: -70px; font-size: 0.6rem; line-height: 1.7; }
    .ribbon .long { display: none; }
  }

  /* the corner to the repository; the octocat waves when pointed at */
  .github-corner { position: fixed; top: 0; right: 0; z-index: 10; line-height: 0; }
  .github-corner svg { width: 72px; height: 72px; fill: var(--text); color: var(--bg); }
  .github-corner:hover .octo-arm { animation: octocat-wave 560ms ease-in-out; }
  @keyframes octocat-wave {
    0%, 100% { transform: rotate(0); }
    20%, 60% { transform: rotate(-25deg); }
    40%, 80% { transform: rotate(10deg); }
  }
  @media (max-width: 900px) {
    /* smaller, to keep clear of the model selector on narrow screens */
    .github-corner svg { width: 52px; height: 52px; }
  }

  header { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 10px 16px; border-bottom: 1px solid var(--line); flex-wrap: wrap; }
  .brand { display: flex; align-items: center; gap: 8px; }
  h1 { font-size: 1.05rem; margin: 0; letter-spacing: 0.01em; }
  .badge { font-size: 0.7rem; color: var(--muted); border: 1px solid var(--line); border-radius: 999px; padding: 1px 8px; }
  .models { display: flex; align-items: center; gap: 6px; min-width: 0; max-width: 100%; }
  .models select { min-width: 0; flex: 1; }
  .open { display: grid; place-items: center; width: 34px; height: 34px; flex: none; color: var(--muted); border: 1px solid var(--line); border-radius: 10px; background: var(--panel); cursor: pointer; }
  .open:hover { color: var(--text); }
  .open:has(input:disabled) { opacity: 0.45; pointer-events: none; }
  select { font: inherit; font-size: 0.85rem; color: var(--text); background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 6px 10px; max-width: 100%; }

  #chat { flex: 1; overflow-y: auto; padding: 16px; display: flex; flex-direction: column; gap: 14px; }
  .intro { color: var(--muted); font-size: 0.85rem; }
  .intro p { margin: 0 0 6px; }
  #kept button { font: inherit; font-size: 0.75rem; color: var(--muted); background: transparent; border: 1px solid var(--line); border-radius: 6px; padding: 0 6px; cursor: pointer; }
  .intro .en { font-size: 0.8rem; }
  .intro[data-language="ja"] .en, .intro[data-language="en"] .ja { display: none; }
  .intro[data-language="en"] .en { font-size: inherit; }
  /* a model named in the text is a way to choose it */
  .intro .choose { font: inherit; color: var(--accent); background: none; border: 0; padding: 0; cursor: pointer; text-decoration: underline; text-underline-offset: 3px; }
  /* the whitespace around an inline button is collapsed away */
  .intro .en .choose { margin: 0 0.3em; }
  .intro .choose:disabled { color: inherit; cursor: default; text-decoration: none; }
  summary { cursor: pointer; color: var(--accent); }
  .intro ul { margin: 6px 0 0; padding-left: 1.2em; }
  a { color: var(--accent); }

  .message { display: flex; flex-direction: column; gap: 4px; }
  .message.user { align-items: flex-end; }
  .bubble { padding: 10px 14px; border-radius: 16px; white-space: pre-wrap; overflow-wrap: anywhere; max-width: 100%; }
  .user .bubble { background: var(--accent); color: var(--accent-text); border-bottom-right-radius: 4px; max-width: 85%; }
  .model .bubble { background: var(--bubble); border-bottom-left-radius: 4px; }
  .model .bubble:empty::before { content: "…"; color: var(--muted); }
  .meta { font-size: 0.72rem; color: var(--muted); padding-inline: 6px; }
  .error .bubble { color: #dc2626; }
  /* T76: the benchmark's table, in the model's bubble */
  .bench .bubble { white-space: normal; }
  .bench-title { font-size: 0.8rem; color: var(--muted); margin-bottom: 6px; }
  .bench table { border-collapse: collapse; font-size: 0.85rem; font-variant-numeric: tabular-nums; }
  .bench th, .bench td { text-align: left; padding: 3px 12px 3px 0; vertical-align: top; }
  .bench th { font-weight: 500; color: var(--muted); border-bottom: 1px solid var(--line); }
  .bench td:nth-child(2) { text-align: right; white-space: nowrap; }  /* a number never breaks; the names may */
  .bench-actions a { color: inherit; text-decoration: underline dotted; text-underline-offset: 3px; }
  /* The meta line and the status line open into their numbers. Closed they must look exactly as they did before,
     so the disclosure triangle goes away and the summary keeps the colour of the line. */
  .meta > summary, #load > summary { color: inherit; list-style: none; }
  .meta > summary::-webkit-details-marker, #load > summary::-webkit-details-marker { display: none; }
  .meta > summary, #load.measured > summary { cursor: pointer; }
  .meta > summary::after, #load.measured > summary::after { content: " ▸"; }
  .meta[open] > summary::after, #load.measured[open] > summary::after { content: " ▾"; }
  .meta > div, #load-stats > div { padding-left: 1.1em; }
  /* nothing to open until the numbers are in */
  #load { min-width: 0; }
  #load:not(.measured) > summary { cursor: default; pointer-events: none; }

  footer { padding: 8px 16px 14px; }
  #status { display: flex; align-items: center; gap: 10px; min-height: 1.4em; font-size: 0.75rem; color: var(--muted); padding: 0 6px 6px; }
  progress { flex: 1; height: 6px; accent-color: var(--accent); }
  #composer { display: flex; gap: 6px; align-items: flex-end; background: var(--panel); border: 1px solid var(--line); border-radius: 24px; padding: 6px; }
  #settings-open { position: relative; display: grid; place-items: center; width: 36px; height: 36px; flex: none; border: 0; border-radius: 50%; background: transparent; color: var(--muted); cursor: pointer; }
  #settings-open:hover { color: var(--text); }
  /* a dot while something differs from the model's defaults */
  #settings-open.changed::after { content: ""; position: absolute; top: 6px; right: 6px; width: 7px; height: 7px; border-radius: 50%; background: var(--accent); }
  /* In the top layer, so it never moves the page. The script puts it above its button; on a narrow screen it is
     a sheet over the composer instead, where a thumb reaches it. */
  .sheet { position: fixed; inset: auto; margin: 0; width: min(320px, calc(100vw - 32px)); box-sizing: border-box; padding: 14px 16px; color: var(--text); background: var(--panel); border: 1px solid var(--line); border-radius: 14px; box-shadow: 0 8px 30px rgb(0 0 0 / 0.25); font-size: 0.85rem; overflow-y: auto; overscroll-behavior: contain; }
  .sheet::backdrop { background: transparent; }
  .sheet input[type="text"] { display: block; width: 100%; box-sizing: border-box; margin-top: 6px; font: inherit; color: var(--text); background: transparent; border: 1px solid var(--line); border-radius: 8px; padding: 5px 8px; }
  .sheet label { display: block; margin-bottom: 10px; color: var(--muted); }
  .sheet output { float: right; color: var(--text); font-variant-numeric: tabular-nums; }
  .sheet input[type="range"] { display: block; width: 100%; margin: 6px 0 0; accent-color: var(--accent); }
  .sheet summary { cursor: pointer; color: var(--muted); margin-bottom: 10px; }
  .sheet .hint { margin: 0 0 10px; color: var(--muted); font-size: 0.78rem; line-height: 1.4; }
  .sheet .switch { display: flex; align-items: center; gap: 8px; color: var(--text); cursor: pointer; }
  .sheet .switch input { margin: 0; accent-color: var(--accent); }
  .sheet .switch:has(input:disabled) { color: var(--muted); cursor: default; }
  .seed-field { display: flex; gap: 6px; margin-top: 6px; }
  .seed-field input { flex: 1; min-width: 0; font: inherit; color: var(--text); background: transparent; border: 1px solid var(--line); border-radius: 8px; padding: 5px 8px; }
  .sheet button { font: inherit; color: var(--muted); background: transparent; border: 1px solid var(--line); border-radius: 8px; padding: 5px 10px; cursor: pointer; }
  .sheet button:hover { color: var(--text); }
  @media (max-width: 640px) {
    .sheet { left: 0 !important; right: 0; top: auto !important; bottom: 0 !important; width: auto; border-radius: 16px 16px 0 0; border-width: 1px 0 0; padding: 18px 20px calc(18px + env(safe-area-inset-bottom)); }
    .sheet::backdrop { background: rgb(0 0 0 / 0.3); }
  }
  /* the seed under an answer is a button: it fixes that seed for the next run */
  .meta .seed { font: inherit; color: inherit; background: none; border: 0; padding: 0; cursor: pointer; text-decoration: underline dotted; text-underline-offset: 3px; }
  #composer:focus-within { border-color: var(--accent); }
  /* grows with its lines (the script sets the height) up to five of them, then scrolls: the page never does */
  #prompt { flex: 1; min-width: 0; font: inherit; line-height: 1.5; color: var(--text); background: transparent; border: 0; outline: 0; resize: none; padding: 6px 0; max-height: calc(7.5em + 12px); overflow-y: auto; }
  #send-hint { flex: none; align-self: flex-end; margin: 0 2px 9px; font: inherit; font-size: 0.68rem; line-height: 1.5; color: var(--muted); border: 1px solid var(--line); border-radius: 6px; padding: 0 5px; white-space: nowrap; user-select: none; }
  @media (hover: none), (pointer: coarse), (max-width: 480px) { #send-hint { display: none; } }
  #run { display: grid; place-items: center; width: 36px; height: 36px; border: 0; border-radius: 50%; background: var(--accent); color: var(--accent-text); cursor: pointer; }
  #run:disabled { opacity: 0.35; cursor: default; }
</style>

<script>
  // The page's script is the modules of src/page/, in the order they are named here. Each runs as it is imported:
  // the ones down to isolation.ts at once; receiver.ts waits for the service worker (and for the one reload of a
  // first visit) and then starts the worker, and what follows it starts after that. Last, the first load:
  import { MODELS } from "../models.js";
  import "../page/dom.ts";
  import { weighed } from "../page/address.ts";
  import { gpuFor, recalled, remember, threadsFor } from "../page/remembered.ts";
  import { page } from "../page/state.ts";
  import { stillKept } from "../page/list.ts";
  import { show } from "../page/settings.ts";
  import "../page/draw.ts";
  import "../page/isolation.ts";
  import { worker } from "../page/receiver.ts";
  import "../page/choose.ts";
  import "../page/composer.ts";

  // (A model chosen while this looks has started the worker itself, and wins: the review of T116)
  (async () => {
    if (page.model === recalled && !(await stillKept(page.model)) && page.loads === 1) {
      page.model = MODELS[0];
      remember(undefined);
      show(page.model);
    }
    if (page.loads === 1) {
      worker.postMessage({ type: "init", search: location.search, model: weighed(page.model), load: page.loads, threads: threadsFor(page.model), gpu: gpuFor(page.model) });
    }
  })();
</script>
