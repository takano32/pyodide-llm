---
// One chat-like screen. Pyodide runs in public/worker.js; this page only draws what the worker reports.
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>Pyodide Llama</title>
  </head>
  <body>
    <!-- Two links to the repository, a ribbon and a corner: the script below shows one of them at random. -->
    <div class="ribbon" hidden><a href="https://github.com/takano32/pyodide-llama-py"><span class="long">Fork me on </span>GitHub</a></div>
    <!-- GitHub Corners, https://github.com/tholman/github-corners (MIT License) -->
    <a href="https://github.com/takano32/pyodide-llama-py" class="github-corner" aria-label="View source on GitHub" hidden>
      <svg viewBox="0 0 250 250" aria-hidden="true">
        <path d="M0,0 L115,115 L130,115 L142,142 L250,250 L250,0 Z"></path>
        <path d="M128.3,109.0 C113.8,99.7 119.0,89.6 119.0,89.6 C122.0,82.7 120.5,78.6 120.5,78.6 C119.2,72.0 123.4,76.3 123.4,76.3 C127.3,80.9 125.5,87.3 125.5,87.3 C122.9,97.6 130.6,101.9 134.4,103.2" fill="currentColor" style="transform-origin: 130px 106px;" class="octo-arm"></path>
        <path d="M115.0,115.0 C114.9,115.1 118.7,116.5 119.8,115.4 L133.7,101.6 C136.9,99.2 139.9,98.4 142.2,98.6 C133.8,88.0 127.5,74.4 143.8,58.0 C148.5,53.4 154.0,51.2 159.7,51.0 C160.3,49.4 163.2,43.6 171.4,40.1 C171.4,40.1 176.1,42.5 178.8,56.2 C183.1,58.6 187.2,61.8 190.9,65.4 C194.5,69.0 197.7,73.2 200.1,77.6 C213.8,80.2 216.3,84.9 216.3,84.9 C212.7,93.1 206.9,96.0 205.4,96.6 C205.1,102.4 203.0,107.8 198.3,112.5 C181.9,128.9 168.3,122.5 157.7,114.1 C157.9,116.9 156.7,120.9 152.7,124.9 L141.0,136.5 C139.8,137.7 141.6,141.9 141.8,141.8 Z" fill="currentColor" class="octo-body"></path>
      </svg>
    </a>
    <header>
      <div class="brand">
        <h1>Pyodide Llama</h1>
        <span class="badge">experiment</span>
      </div>
      <select id="model" aria-label="Model"></select>
    </header>

    <main id="chat">
      <section class="intro">
        <p>
          ブラウザ上の WebAssembly 版 Python（Pyodide + NumPy）だけで言語モデルを動かす実験です。
          実用ではなく試験が目的なので、モデルは小さく、出力はそれなりです。
        </p>
        <p class="en">
          An experiment in how far Python on WebAssembly can go: a language model that runs entirely in your
          browser, written in Python with NumPy on Pyodide. A test bed, not a product.
        </p>
        <details>
          <summary>このプロジェクトについて / About, models and licenses</summary>
          <ul>
            <li><a href="https://github.com/takano32/pyodide-llama-py">github.com/takano32/pyodide-llama-py</a></li>
            <li><a href="https://pyodide.org/">Pyodide</a>: Python for the browser, based on WebAssembly</li>
            <li><a href="https://github.com/tairov/llama2.py">llama2.py</a> and <a href="https://github.com/karpathy/llama2.c">llama2.c</a>, which the NumPy engine is a port of</li>
            <li><a href="https://huggingface.co/llm-jp/llm-jp-3-150m">llm-jp-3-150m</a> (Apache License 2.0)</li>
            <li><a href="https://huggingface.co/sbintuitions/tiny-lm">tiny-lm</a> (<a href="models/tiny-lm.LICENSE.txt">MIT License</a>)</li>
            <li><a href="https://huggingface.co/karpathy/tinyllamas">karpathy/tinyllamas</a> and <a href="https://huggingface.co/ellishg/tinyllamas">ellishg/tinyllamas</a> (MIT License)</li>
          </ul>
        </details>
      </section>
    </main>

    <footer>
      <div id="status" role="status">
        <span id="status-text">Initializing...</span>
        <progress id="progress" hidden></progress>
      </div>
      <form id="composer">
        <input id="prompt" autocomplete="off" />
        <!-- the same button stops the run that is going on; the script swaps the arrow for a square -->
        <button id="run" disabled aria-label="Run">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M3 20.5 21 12 3 3.5v6.6L15 12 3 13.9z" fill="currentColor" /></svg>
        </button>
      </form>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #ffffff; --panel: #f4f4f5; --text: #18181b; --muted: #71717a; --line: #e4e4e7;
    --accent: #2563eb; --accent-text: #ffffff; --bubble: #f4f4f5;
    font-family: system-ui, -apple-system, "Segoe UI", "Hiragino Sans", "Noto Sans JP", sans-serif;
  }
  @media (prefers-color-scheme: dark) {
    :root { --bg: #0f0f11; --panel: #1c1c1f; --text: #ededf0; --muted: #9a9aa3; --line: #2c2c31; --accent: #3b82f6; --bubble: #1c1c1f; }
  }
  * { box-sizing: border-box; }
  /* The page itself never scrolls: only the conversation does, and the composer stays at the bottom. */
  html, body { height: 100%; margin: 0; }
  body { display: flex; flex-direction: column; height: 100dvh; background: var(--bg); color: var(--text); line-height: 1.6; }
  #chat > * { width: 100%; max-width: 760px; margin-inline: auto; }
  /* their padding is inside the box: 760px of content, like the conversation */
  header, footer { width: 100%; max-width: 792px; margin-inline: auto; }

  /* the corner ribbon to the repository */
  .ribbon[hidden], .github-corner[hidden] { display: none; }
  .ribbon { position: fixed; top: 0; right: 0; width: 130px; height: 130px; overflow: hidden; pointer-events: none; z-index: 10; }
  .ribbon a { position: absolute; top: 28px; right: -46px; width: 190px; transform: rotate(45deg); pointer-events: auto;
    background: var(--text); color: var(--bg); text-align: center; text-decoration: none; font-size: 0.72rem; font-weight: 600;
    line-height: 2; box-shadow: 0 1px 4px rgb(0 0 0 / 0.3); }
  @media (max-width: 900px) {
    /* keep clear of the header on narrow screens */
    .ribbon { width: 60px; height: 60px; }
    .ribbon a { top: 8px; right: -70px; font-size: 0.6rem; line-height: 1.7; }
    .ribbon .long { display: none; }
  }

  /* the corner to the repository; the octocat waves when pointed at */
  .github-corner { position: fixed; top: 0; right: 0; z-index: 10; line-height: 0; }
  .github-corner svg { width: 72px; height: 72px; fill: var(--text); color: var(--bg); }
  .github-corner:hover .octo-arm { animation: octocat-wave 560ms ease-in-out; }
  @keyframes octocat-wave {
    0%, 100% { transform: rotate(0); }
    20%, 60% { transform: rotate(-25deg); }
    40%, 80% { transform: rotate(10deg); }
  }
  @media (max-width: 900px) {
    /* smaller, to keep clear of the model selector on narrow screens */
    .github-corner svg { width: 52px; height: 52px; }
  }

  header { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 10px 16px; border-bottom: 1px solid var(--line); flex-wrap: wrap; }
  .brand { display: flex; align-items: center; gap: 8px; }
  h1 { font-size: 1.05rem; margin: 0; letter-spacing: 0.01em; }
  .badge { font-size: 0.7rem; color: var(--muted); border: 1px solid var(--line); border-radius: 999px; padding: 1px 8px; }
  select { font: inherit; font-size: 0.85rem; color: var(--text); background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 6px 10px; max-width: 100%; }

  #chat { flex: 1; overflow-y: auto; padding: 16px; display: flex; flex-direction: column; gap: 14px; }
  .intro { color: var(--muted); font-size: 0.85rem; }
  .intro p { margin: 0 0 6px; }
  .intro .en { font-size: 0.8rem; }
  summary { cursor: pointer; color: var(--accent); }
  .intro ul { margin: 6px 0 0; padding-left: 1.2em; }
  a { color: var(--accent); }

  .message { display: flex; flex-direction: column; gap: 4px; }
  .message.user { align-items: flex-end; }
  .bubble { padding: 10px 14px; border-radius: 16px; white-space: pre-wrap; overflow-wrap: anywhere; max-width: 100%; }
  .user .bubble { background: var(--accent); color: var(--accent-text); border-bottom-right-radius: 4px; max-width: 85%; }
  .model .bubble { background: var(--bubble); border-bottom-left-radius: 4px; }
  .model .bubble:empty::before { content: "…"; color: var(--muted); }
  .meta { font-size: 0.72rem; color: var(--muted); padding-inline: 6px; }
  .error .bubble { color: #dc2626; }

  footer { padding: 8px 16px 14px; }
  #status { display: flex; align-items: center; gap: 10px; min-height: 1.4em; font-size: 0.75rem; color: var(--muted); padding: 0 6px 6px; }
  progress { flex: 1; height: 6px; accent-color: var(--accent); }
  #composer { display: flex; gap: 8px; align-items: center; background: var(--panel); border: 1px solid var(--line); border-radius: 999px; padding: 6px 6px 6px 16px; }
  #composer:focus-within { border-color: var(--accent); }
  #prompt { flex: 1; min-width: 0; font: inherit; color: var(--text); background: transparent; border: 0; outline: 0; }
  #run { display: grid; place-items: center; width: 36px; height: 36px; border: 0; border-radius: 50%; background: var(--accent); color: var(--accent-text); cursor: pointer; }
  #run:disabled { opacity: 0.35; cursor: default; }
</style>

<script>
  import { MODELS } from "../models.js";

  declare const __BUILD__: string;
  const $ = (id: string) => document.getElementById(id)!;
  const chat = $("chat"), select = $("model") as HTMLSelectElement, prompt = $("prompt") as HTMLInputElement;
  const run = $("run") as HTMLButtonElement, statusText = $("status-text"), progress = $("progress") as HTMLProgressElement;

  // the ribbon or the corner, whichever the dice say
  document.querySelector(Math.random() < 0.5 ? ".ribbon" : ".github-corner")!.removeAttribute("hidden");

  for (const { id, name, note } of MODELS) {
    select.add(new Option(`${name} — ${note}`, id));
  }
  const requested = new URLSearchParams(location.search).get("model");
  let model = MODELS.find(({ id }) => id === requested) ?? MODELS[0];
  let ready = false;
  let answer: HTMLElement | null = null; // the bubble that is being written

  // The round button is the only control: an arrow that sends, a square that stops the run that is going on.
  const RUN_ICON = "M3 20.5 21 12 3 3.5v6.6L15 12 3 13.9z", STOP_ICON = "M7 7h10v10H7z";
  let generating = false;
  function setGenerating(current: boolean) {
    generating = current;
    run.querySelector("path")!.setAttribute("d", current ? STOP_ICON : RUN_ICON);
    run.setAttribute("aria-label", current ? "Stop" : "Run");
  }

  function show(current: typeof model) {
    select.value = current.id;
    prompt.value = current.prompt;
    prompt.placeholder = current.placeholder;
  }
  show(model);

  function message(kind: string, text = "") {
    const element = document.createElement("div");
    element.className = `message ${kind}`;
    const bubble = document.createElement("div");
    bubble.className = "bubble";
    bubble.textContent = text;
    element.append(bubble);
    chat.append(element);
    chat.scrollTop = chat.scrollHeight;
    return element;
  }
  function meta(element: Element, text: string) {
    const line = document.createElement("div");
    line.className = "meta";
    line.textContent = text;
    element.append(line);
    chat.scrollTop = chat.scrollHeight;
  }

  // ?v=<commit>: a new page must never run with the cached worker or Python code of the previous deployment
  const worker = new Worker(`${import.meta.env.BASE_URL}worker.js?v=${__BUILD__}`, { type: "module" });
  worker.onmessage = ({ data }) => {
    if (data.type === "status") {
      statusText.textContent = data.text;
    } else if (data.type === "progress") {
      progress.hidden = false;
      progress.max = data.total;
      progress.value = data.received;
      statusText.textContent = `${model.name}: ${(data.received / 1e6).toFixed(1)} / ${(data.total / 1e6).toFixed(1)} MB`;
    } else if (data.type === "ready") {
      ready = true;
      // the model is in the Cache API now: ask the browser not to evict it (only a page may ask, not a worker)
      navigator.storage?.persist?.();
      statusText.textContent = `${model.name} · ${data.backend} · Pyodide ${data.pyodide}`;
    } else if (data.type === "token") {
      // stick to the bottom only while the reader is there
      const pinned = chat.scrollHeight - chat.scrollTop - chat.clientHeight < 40;
      answer!.firstElementChild!.textContent += data.text;
      if (pinned) {
        chat.scrollTop = chat.scrollHeight;
      }
    } else if (data.type === "done") {
      meta(answer!, `${model.name} · ${data.tokens} tokens · ${data.tokens_per_second.toFixed(1)} tok/s`);
    } else if (data.type === "error") {
      message("model error", data.message);
      statusText.textContent = ready ? `${model.name}` : "Failed to initialize";
    }
    // anything but a progress report means the worker is idle again
    if (!["status", "progress", "token"].includes(data.type)) {
      progress.hidden = true;
      setGenerating(false);
      run.disabled = !ready;
      select.disabled = false;
    }
  };
  worker.onerror = (event) => {
    message("model error", `Failed to start the worker: ${event.message}`);
  };
  select.disabled = true;
  worker.postMessage({ type: "init", search: location.search, model });

  select.onchange = () => {
    model = MODELS.find(({ id }) => id === select.value)!;
    show(model);
    ready = false;
    run.disabled = select.disabled = true;
    worker.postMessage({ type: "load", model });
  };

  run.onclick = (event) => {
    // While generating the button stops the run instead of submitting the form. Enter in the text field clicks
    // it too (that is how a form is submitted implicitly), so only a real press counts: a click of the pointer
    // (detail 1 and more) or a key on the focused button (detail 0, but then it has the focus).
    if (generating && (event.detail > 0 || document.activeElement === run)) {
      event.preventDefault();
      worker.postMessage({ type: "stop" });
    }
  };

  $("composer").onsubmit = (event) => {
    event.preventDefault();
    // Enter submits the form even while the button is disabled or a run is going on
    if (run.disabled || generating) {
      return;
    }
    setGenerating(true);
    select.disabled = true;
    message("user", prompt.value);
    answer = message("model");
    worker.postMessage({ type: "generate", prompt: prompt.value, ...model.generation });
  };
</script>
